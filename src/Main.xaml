<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Timezone Switcher" Width="400" Height="790" MinWidth="370" MinHeight="610" Background="#F6F7FA" Foreground="#18212B" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#E9ECF0"/><Setter Property="Foreground" Value="#18212B"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#DCEBE3"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#19764A"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="20,18,20,16">
  <Grid Margin="0,0,0,18"><TextBlock Text="Timezone Switcher" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="HideButton" Content="В трей" HorizontalAlignment="Right" Padding="10,7" AutomationProperties.Name="Свернуть в системный трей"/></Grid>
  <Border Background="#E6F3EC" BorderBrush="#B8DDC9" BorderThickness="1" CornerRadius="18" Padding="17" Margin="0,0,0,16">
   <StackPanel><TextBlock Text="Часовой пояс Windows" Foreground="#486354" FontSize="12"/><TextBlock x:Name="ActiveZone" Text="Проверка…" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,5"/><TextBlock x:Name="SystemClock" FontSize="36" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><TextBlock x:Name="SystemDate" Foreground="#486354" FontSize="12" Margin="0,3,0,0"/></StackPanel>
  </Border>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ManualButton" Content="Ручной"/><Button x:Name="AutoButton" Grid.Column="2" Content="Авто"/></Grid>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Button x:Name="MoscowButton" Background="White" HorizontalContentAlignment="Stretch" Padding="16" AutomationProperties.Name="Выбрать Москву и ручной режим"><StackPanel><TextBlock Text="Москва" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="MoscowClock" FontSize="30" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="0,10,0,5"/><TextBlock x:Name="MoscowOffset" Foreground="#526071" FontSize="12"/></StackPanel></Button>
   <Button x:Name="BerlinButton" Grid.Column="2" Background="White" Padding="16" AutomationProperties.Name="Выбрать Берлин и ручной режим"><StackPanel><TextBlock Text="Берлин" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="BerlinClock" FontSize="30" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="0,10,0,5"/><TextBlock x:Name="BerlinOffset" Foreground="#526071" FontSize="12"/></StackPanel></Button>
  </Grid>
  <StackPanel x:Name="ManualZonesPanel" Margin="0,0,0,16">
   <Grid Margin="0,0,0,8"><TextBlock Text="Мои часовые пояса" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="AddZoneButton" Content="+ Добавить" HorizontalAlignment="Right" Padding="10,6"/></Grid>
   <ComboBox x:Name="FavoriteZones" Padding="8" FontSize="12" AutomationProperties.Name="Сохранённые часовые пояса"/>
   <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Button x:Name="ApplyZoneButton" Content="Применить" Background="#D1EBDE" Padding="10,7"/><Button x:Name="RemoveZoneButton" Grid.Column="2" Content="Убрать" Padding="10,7" ToolTip="Убрать из списка, не меняя часовой пояс Windows"/></Grid>
  </StackPanel>
  <TextBlock x:Name="StatusTitle" Text="Ручной режим" FontWeight="SemiBold"/>
  <TextBlock x:Name="StatusDetail" Text="Выберите город. Автоматика не меняет ваш выбор." Foreground="#526071" FontSize="12" Margin="0,5,0,12" MinHeight="36"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="CheckButton" Content="Проверить сейчас"/><Button x:Name="SettingsButton" Grid.Column="2" Content="Настройки"/></Grid>
  <TextBlock x:Name="Footer" Text="Закрытие окна оставляет приложение в трее" FontSize="11" Foreground="#526071" Margin="0,14,0,0" TextAlignment="Center"/>
 </StackPanel></ScrollViewer>
</Window>
